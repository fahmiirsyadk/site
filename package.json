{
  "name": "site-ps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "purs-ts dev",
    "build": "pnpm build:ps && vite build && tsx scripts/prerender-meta.ts",
    "preview": "vite preview",
    "typecheck": "pnpm build:ps && tsc --noEmit",
    "format": "prettier -w .",
    "test": "pnpm build:ps && vitest run",
    "lint": "oxlint src scripts",
    "build:ps": "purs-ts build",
    "check": "node scripts/check-backend-package.mjs && node scripts/check-ffi.mjs && pnpm build:ps && node scripts/check-generated-output.mjs && tsc --noEmit && vitest run",
    "check:backend": "node scripts/check-backend-package.mjs",
    "check:ffi": "node scripts/check-ffi.mjs",
    "check:generated": "node scripts/check-generated-output.mjs"
  },
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=11.22.0"
  },
  "dependencies": {
    "effect": "4.0.0-rc.112",
    "foldkit": "0.153.0",
    "markdown-it": "^14.3.0",
    "markdown-it-footnote": "^4.0.0",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@foldkit/devtools": "0.153.0",
    "@foldkit/devtools-mcp": "0.19.0",
    "@foldkit/oxlint-plugin": "0.9.0",
    "@foldkit/ui": "0.153.0",
    "@foldkit/vite-plugin": "0.19.0",
    "@oxlint/plugins": "1.80.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/markdown-it": "^14.1.2",
    "happy-dom": "^20.10.4",
    "oxlint": "^1.80.0",
    "prettier": "^3.8.4",
    "purescript": "0.15.16",
    "purescript-foldkit": "file:vendor/purescript-foldkit-0.1.0.tgz",
    "purs-backend-ts": "file:vendor/purs-backend-ts-0.1.0.tgz",
    "spago": "1.0.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
