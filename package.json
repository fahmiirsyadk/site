{
  "name": "site-css",
  "private": true,
  "description": "CSS toolchain only for TailwindDX on the Haskell blog built with Shake+Lucid+Slick.",
  "scripts": {
    "css:dev": "tailwindcss --watch -i ./css/style.css -o ./build/css/style.css",
    "css:build": "tailwindcss -i ./css/style.css -o ./build/css/style.css --minify"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  }
}